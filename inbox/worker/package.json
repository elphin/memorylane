{
  "name": "memorylane-inbox-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MemoryLane Onderweg — Cloudflare Worker (API + brievenbus). Losstaand van de root-app.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "wrangler deploy --dry-run --outdir dist",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "migrate:local": "wrangler d1 migrations apply memorylane-inbox --local",
    "migrate:remote": "wrangler d1 migrations apply memorylane-inbox --remote"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260928.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.143.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20260926.1": true
  }
}
